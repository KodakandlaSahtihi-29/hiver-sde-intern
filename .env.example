# Environment Configuration Template for @AppleSupport AI Agent
# Copy to .env and insert your API keys if you wish to use external LLM generation/judging.
# If no keys are provided, the system operates seamlessly using deterministic grounded synthesis.

LLM_PROVIDER=grounded_synthesis
# Optional: Set to 'gemini' or 'openai' if you wish to use remote LLMs
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# System configuration
RETRIEVAL_TOP_K=3
CONFIDENCE_THRESHOLD=0.55
SIMILARITY_THRESHOLD=0.18
